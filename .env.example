# Optional. Copy this file to .env before first launch to customize.
HOST=127.0.0.1
PORT=3040
DATA_DIR=./data
SEED_DEMO=true
# With SEED_DEMO=false, set ADMIN_PASSWORD (12+ characters) before first launch.
# ADMIN_EMAIL=admin@sushiclinic.local
# ADMIN_PASSWORD=replace-with-your-own-long-password
# Only true when serving through HTTPS, not on local HTTP.
COOKIE_SECURE=false
